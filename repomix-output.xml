            #   portrait_sets: toxoids { species_class = TOX }
            #   species_classes: TOX = { ... }
            #   greeting example: tox_portrait_01
            Id              = "toxoid"
            DisplayName     = "Toxoid"
            FilenameAbbr    = "tox"
            CategoryKey     = "toxoids"
