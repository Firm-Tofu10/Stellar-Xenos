            VanillaSets     = @("molluscoids", "synthetic_molluscoids", "ep9_exclusive_molluscoid", "biogenesis_molluscoids", "psionic_molluscoids")
        }
        [PSCustomObject]@{
            Id              = "fungoid"
            DisplayName     = "Fungoid"
            FilenameAbbr    = "fun"
            CategoryKey     = "fungoids"
